{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waypointstudio.org/schema/spatial.schema.json",
  "title": "Waypoint Spatial Attachment",
  "description": "Optional spatial descriptor for an entity or relationship.",
  "type": "object",
  "required": ["kind"],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "point",
        "line",
        "polygon",
        "region_ref",
        "bbox"
      ]
    },
    "geometry": {
      "type": "object",
      "description": "GeoJSON geometry object when kind is point, line, or polygon.",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Point", "LineString", "Polygon", "MultiPoint", "MultiLineString", "MultiPolygon"]
        },
        "coordinates": true
      }
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" },
      "description": "[west, south, east, north] in WGS84."
    },
    "regionId": {
      "type": "string",
      "pattern": "^wp:(location|region|park|habitat|trail|river):[a-z0-9][a-z0-9_-]*$",
      "description": "Reference to a place entity when kind is region_ref."
    },
    "placeHierarchy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional denormalized place labels for display. Canonical hierarchy uses within edges.",
      "properties": {
        "habitat": { "type": "string" },
        "trail": { "type": "string" },
        "park": { "type": "string" },
        "managementArea": { "type": "string" },
        "watershed": { "type": "string" },
        "county": { "type": "string" },
        "state": { "type": "string" },
        "country": { "type": "string" }
      }
    },
    "precision": {
      "type": "string",
      "enum": ["exact", "approximate", "obscured", "region_only"],
      "description": "exact = precise coords; obscured = privacy-reduced; region_only = no point stored."
    },
    "crs": {
      "type": "string",
      "default": "EPSG:4326",
      "description": "Coordinate reference system. Default WGS84."
    }
  }
}
