{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waypointstudio.org/schema/relationship.schema.json",
  "title": "Waypoint Relationship",
  "description": "A typed directed edge between two Waypoint entities.",
  "type": "object",
  "required": ["id", "type", "from", "to", "provenance"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable relationship ID. Prefer rel:{slug} or UUID."
    },
    "type": {
      "type": "string",
      "description": "Relationship type key from the relationship-types registry."
    },
    "from": {
      "type": "string",
      "pattern": "^wp:[a-z][a-z0-9_]*:[a-z0-9][a-z0-9_-]*$",
      "description": "Source entity ID."
    },
    "to": {
      "type": "string",
      "pattern": "^wp:[a-z][a-z0-9_]*:[a-z0-9][a-z0-9_-]*$",
      "description": "Target entity ID."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Optional confidence for observed or inferred edges."
    },
    "temporal": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "temporal.schema.json" }
      ]
    },
    "spatial": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "spatial.schema.json" }
      ]
    },
    "provenance": {
      "type": "object",
      "required": ["source", "createdAt"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "properties": {
      "type": "object",
      "additionalProperties": true,
      "description": "Type-specific metadata (e.g. distance meters for found_near)."
    }
  }
}
