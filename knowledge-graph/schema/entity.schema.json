{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waypointstudio.org/schema/entity.schema.json",
  "title": "Waypoint Entity",
  "description": "A durable node in the Waypoint knowledge graph.",
  "type": "object",
  "required": ["id", "type", "label", "status", "provenance"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^wp:[a-z][a-z0-9_]*:[a-z0-9][a-z0-9_-]*$",
      "description": "Stable Waypoint ID: wp:{entityType}:{slug}"
    },
    "type": {
      "type": "string",
      "description": "Entity type key from the entity-types registry."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable display name."
    },
    "summary": {
      "type": "string",
      "description": "Short plain-language description."
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Alternate names, including scientific names when useful."
    },
    "status": {
      "type": "string",
      "enum": ["active", "draft", "archived"],
      "default": "active"
    },
    "spatial": {
      "description": "Optional spatial attachment. Null if unknown.",
      "oneOf": [
        { "type": "null" },
        { "$ref": "spatial.schema.json" }
      ]
    },
    "temporal": {
      "description": "Optional temporal attachment. Null if unknown.",
      "oneOf": [
        { "type": "null" },
        { "$ref": "temporal.schema.json" }
      ]
    },
    "externalIds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["system", "value"],
        "additionalProperties": false,
        "properties": {
          "system": {
            "type": "string",
            "description": "External authority: itis, gbif, inaturalist, doi, osm, noaa, isbn, etc."
          },
          "value": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "properties": {
      "type": "object",
      "description": "Type-specific bag of fields. Keep shared meaning in typed relationships when possible.",
      "additionalProperties": true
    },
    "apps": {
      "type": "array",
      "description": "Hint list of Waypoint products that surface this entity. Not an access-control list.",
      "items": {
        "type": "string",
        "enum": [
          "foragecast",
          "fieldry",
          "sheds",
          "volunteer",
          "waypoint-scenes",
          "education",
          "gallery",
          "workshop",
          "platform"
        ]
      },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Lightweight free tags. Prefer relationships for structured meaning."
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["source", "createdAt"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "description": "Origin system or editorial stream, e.g. waypoint-editorial, fieldry, foragecast, import:gbif."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO-8601 date or datetime."
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO-8601 date or datetime."
        },
        "createdBy": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
