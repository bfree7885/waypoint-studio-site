{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waypointstudio.org/schema/graph-document.schema.json",
  "title": "Waypoint Graph Document",
  "description": "A portable document containing entities and relationships. Used for seeds, examples, and editorial imports.",
  "type": "object",
  "required": ["version", "entities", "relationships"],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "generatedAt": { "type": "string" },
    "entities": {
      "type": "array",
      "items": { "$ref": "entity.schema.json" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "relationship.schema.json" }
    }
  }
}
